# SOLAR HUB Centralized Backend Configuration
PORT=3000

# Backend-only Admin credentials (NEVER expose in Android APK or frontend JS)
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Secret used to sign session tokens (change to a random 64-char hex string in production)
TOKEN_SECRET=CHANGE_ME_RANDOM_TOKEN_SECRET

# Optional: PostgreSQL connection string (e.g. Supabase Free Tier / Neon / Render Postgres)
# When omitted, uses persistent atomic file storage at ./data/solarhub.json with automatic rolling backups
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Optional: Supabase Storage for persistent cloud attachments (free tier compatible)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_BUCKET=solar-hub-files
